{%- comment -%} Every published post with its tags, for the research map on the CV (posts.json keeps only the latest three) {%- endcomment -%}
[{% for post in site.posts %}
  { "title": {{ post.title | jsonify }}, "url": {{ post.url | remove_first: "/personalcv" | jsonify }}, "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "tags": {{ post.tags | jsonify }} }{% unless forloop.last %},{% endunless %}{% endfor %}
]
